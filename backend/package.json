{
  "name": "@app/backend",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#tests/*": "./tests/*"
  },
  "scripts": {
    "create:env": "node -e \"require('fs').copyFileSync('.env.example', '.env', require('fs').constants.COPYFILE_EXCL)\"",
    "dev": "node --env-file=.env --watch src/index.ts | pino-pretty -clSt",
    "start": "node --env-file=.env --watch src/index.ts | pino-pretty -clSt",
    "start:prod": "node --env-file=.env ./src/index.ts",
    "test": "node --test 'src/**/*.spec.ts'",
    "test:integration": "node --test --test-concurrency=1 'tests/**/*.test.ts'",
    "test:coverage": "c8 node --test --test-concurrency=1 'src/**/*.spec.ts' 'tests/**/*.test.ts'",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "type:check": "tsc --noEmit",
    "check": "biome check && tsc --noEmit",
    "check:fix": "biome check --write && tsc --noEmit",
    "db": "dbmate h",
    "db:create-migration": "dbmate new",
    "db:migrate": "dbmate -e DBMATE_DATABASE_URL --no-dump-schema up",
    "db:rollback": "dbmate -e DBMATE_DATABASE_URL --no-dump-schema down",
    "db:create-seed": "dbmate -e DBMATE_DATABASE_URL -d ./db/seeds/ new",
    "db:seed": "dbmate -e DBMATE_DATABASE_URL -d ./db/seeds/ up",
    "db:seed:down": "dbmate -e DBMATE_DATABASE_URL -d ./db/seeds/ down",
    "db:seed:reset": "node --env-file=.env scripts/reset-seeds.mjs && pnpm db:seed",
    "postinstall": "husky"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/jwt": "10.2.1",
    "@fastify/request-context": "6.2.1",
    "@fastify/sse": "0.6.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "5.2.6",
    "@fastify/type-provider-typebox": "6.1.0",
    "env-schema": "7.0.0",
    "fastify": "5.10.0",
    "fastify-plugin": "5.1.0",
    "postgres": "3.4.9",
    "typebox": "1.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@types/node": "25.9.5",
    "c8": "10.1.3",
    "dbmate": "2.34.1",
    "husky": "9.1.7",
    "pino-pretty": "13.1.3",
    "typescript": "5.9.3"
  },
  "keywords": [
    "fastify",
    "typescript",
    "postgres",
    "openapi",
    "template",
    "boilerplate"
  ]
}
