LOG_LEVEL=info
NODE_ENV=development
PORT=3000
# Comma-separated allowed CORS origins. Defaults to the local frontend in development.
CORS_ORIGIN=http://localhost:3001
POSTGRES_PASSWORD=test
POSTGRES_USER=admin
POSTGRES_DB=test
POSTGRES_URL=127.0.0.1:5432
DBMATE_DATABASE_URL=postgres://admin:test@127.0.0.1:5432/test?sslmode=disable

# Signs session JWTs. THIS IS A DEVELOPMENT VALUE AND MUST BE REPLACED IN PRODUCTION
# with a high-entropy secret (e.g. `openssl rand -base64 48`). Anyone holding it can
# mint a session for any user. There is no default in code: the app refuses to boot
# without it. Minimum 32 characters.
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-in-production-0123456789
# Session lifetime in seconds (4 hours). Also the session cookie's Max-Age.
SESSION_TTL_SECONDS=14400

# ── Orchestration engine ──────────────────────────────────────────────────────
# Every EngineConfig knob. Defaults (applied when unset) are shown; see
# docs/OrchestrationEngine.md §17 for what each one controls.
# Maximum jobs in flight in this process at once.
ENGINE_CONCURRENCY=4
# How often the claim loop runs when idle; a freed slot also triggers an immediate tick.
ENGINE_POLL_INTERVAL_MS=200
# How long a claimed row stays owned before another runner may steal it.
ENGINE_LEASE_MS=30000
# How often in-flight leases are bumped. Must be comfortably below ENGINE_LEASE_MS.
ENGINE_HEARTBEAT_MS=10000
# Attempts a freshly submitted task gets before it is declared failed.
ENGINE_MAX_ATTEMPTS=3
# First retry delay; doubles per attempt, capped by ENGINE_BACKOFF_MAX_MS, plus up to 20% jitter.
ENGINE_BACKOFF_BASE_MS=500
ENGINE_BACKOFF_MAX_MS=30000
# Liveness backstop for a worker that hangs and ignores its abort signal — not a per-job SLA.
ENGINE_JOB_TIMEOUT_MS=300000
# Requeue every `running` row this process does not own, once, at startup. MUST be false if you
# run more than one backend process against this database.
ENGINE_BOOT_SWEEP=true
