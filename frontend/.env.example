# ── Frontend environment ────────────────────────────────────────────────────
# Copy to `.env.local` for local development: cp .env.example .env.local

# Base URL the generated API client prefixes onto every request.
# Leave EMPTY to use same-origin requests that Next.js proxies to the backend
# (see `rewrites` in next.config.ts) — this avoids CORS entirely.
# Set to an absolute URL (e.g. https://api.example.com) to call the backend directly.
NEXT_PUBLIC_API_URL=

# Backend origin the Next.js proxy forwards /api/* to (server-side only).
# Local dev default is http://localhost:3000; in docker-compose use http://backend:3000.
BACKEND_URL=http://localhost:3000

# Used only by `pnpm openapi:pull` / `pnpm generate:api:live`.
OPENAPI_URL=http://127.0.0.1:3000/api-docs/json
