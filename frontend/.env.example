# ── Frontend environment ────────────────────────────────────────────────────
# Copy to `.env.local` for local development: cp .env.example .env.local

# Absolute base URL the generated API client prefixes onto every request.
# REQUIRED. The browser calls the backend directly — there is no Next.js rewrite
# proxy any more — so an empty value means same-origin, and same-origin now
# serves the frontend rather than the API.
# Local dev: http://localhost:3000. Deployed: https://queue-api.example.com.
#
# Being a NEXT_PUBLIC_* variable, this is inlined into the client bundle at
# BUILD time (`next build`); setting it only at runtime is too late. The
# backend's CORS_ORIGIN must name this frontend's origin in return.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Used only by `pnpm openapi:pull` / `pnpm generate:api:live`.
OPENAPI_URL=http://127.0.0.1:3000/api-docs/json
